PORT=3000
MONGO_URI=<your-mongo-uri>
JWT_ACCESS_TOKEN=<your-jwt-access-token>
JWT_SECRET_TOKEN=<your-jwt-secret-token>
GOOGLE_USER=<gmail-address-sending-otp>

# --- Email: Pick ONE of the two strategies below ---

# Strategy 1 (RECOMMENDED): Gmail App Password — never expires
# Enable 2FA on your Google account, then generate an App Password:
# https://myaccount.google.com/apppasswords
GOOGLE_APP_PASSWORD=<your-gmail-app-password>

# Strategy 2: Gmail OAuth2 — refresh token expires after 7 days in "Testing" mode
# GOOGLE_CLIENT_ID=<google-oauth2-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth2-client-secret>
# GOOGLE_REFRESH_TOKEN=<google-oauth2-refresh-token>

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
FIELD_ENCRYPTION_SECRET=<32-byte-key-for-aes-256-gcm>